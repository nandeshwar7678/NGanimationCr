<IfModule mod_rewrite.c>
  RewriteEngine On

  # www -> non-www
  RewriteCond %{HTTP_HOST} ^www\.aicloudetools\.com$ [NC]
  RewriteRule ^(.*)$ https://aicloudetools.com/$1 [R=301,L]

  # Existing files/folders
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # React routes
  RewriteRule ^ index.html [L]
</IfModule>
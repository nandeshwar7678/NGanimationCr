<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteBase /

  # Existing files and folders ko directly serve karo
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Baaki React routes ko index.html par bhejo
  RewriteRule ^ index.html [L]
</IfModule>